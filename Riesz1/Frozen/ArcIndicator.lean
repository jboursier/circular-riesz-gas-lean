public import Mathlib.Tactic

/-!
# Arc indicator: `Riesz1.arcIndicator`

Indicator of an open arc.
-/

@[expose] public section

noncomputable section

open MeasureTheory Filter
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz1

/-- Indicator of an open arc. -/
def arcIndicator (center : UnitAddCircle) (a : ℝ) (x : UnitAddCircle) : ℝ :=
  if dist x center < a then 1 else 0


end Riesz1

end
end
